# ============================================
# OmniMind 庄家视角多智能体分析系统 - 环境变量配置
# ============================================
# 仅保留基础设施配置。API 密钥等业务配置请通过管理后台设置。
# 使用方法：复制此文件为 .env，填入实际值
# cp .env.example .env

# ---------- 数据库 ----------
DATABASE_URL=postgresql+asyncpg://omnimind:password@localhost:5432/omnimind
REDIS_URL=redis://localhost:6379
POSTGRES_USER=omnimind
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=omnimind

# ---------- 安全 ----------
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256

# ---------- 应用 ----------
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
API_PROXY_URL=http://localhost:8000

# ---------- 前端 ----------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
NEXT_PUBLIC_SENTRY_DSN=

# ---------- 生产环境（docker-compose.prod.yml 使用） ----------
PUBLIC_API_URL=https://your-domain.com/api

# ---------- 业务配置 ----------
# AI 密钥、数据源 API Key、支付密钥、推送 Token 等
# 请通过管理后台 /settings/configs 页面配置，无需在此设置

# CoinMarketCal API (可选，获取地址: https://coinmarketcal.com/en/api)
COINMARKETCAL_API_KEY=

# ---------- 网络代理（VPN/Clash） ----------
# Docker 容器通过宿主机代理访问外网（如 Clash、V2Ray）
# 如果不需要代理，留空或删除这两行
# HTTP_PROXY=http://host.docker.internal:7890
# HTTPS_PROXY=http://host.docker.internal:7890
